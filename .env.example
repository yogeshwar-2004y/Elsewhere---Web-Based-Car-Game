# Optional: only needed when the multiplayer server is hosted separately.
# Set this before npm run build; omit it for same-origin hosting.
# VITE_MULTIPLAYER_URL=wss://your-room-server.example/room
# Vercel: set this in Project Settings > Environment Variables, then redeploy.
# Use the actual Render service hostname, not the Vercel frontend hostname.

